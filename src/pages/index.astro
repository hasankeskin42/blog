---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import automationHero from '../assets/industrial-automation-hero.svg';
import plcIllustration from '../assets/plc-automation.svg';
import maintenanceIllustration from '../assets/electrical-maintenance.svg';
import designIllustration from '../assets/engineering-design.svg';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="tr">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.home-main {
				width: 100%;
				max-width: none;
				padding: 0;
			}
			.container {
				width: min(var(--page-width), calc(100% - 2.5rem));
				margin: 0 auto;
			}
			.hero {
				position: relative;
				display: flex;
				min-height: 500px;
				align-items: center;
				overflow: hidden;
				background: #10243e;
				color: #fff;
				isolation: isolate;
			}
			.hero-image,
			.hero-shade {
				position: absolute;
				z-index: -1;
				inset: 0;
				width: 100%;
				height: 100%;
			}
			.hero-image {
				object-fit: cover;
				object-position: center 48%;
			}
			.hero-shade {
				background: linear-gradient(90deg, rgba(7, 20, 32, 0.96) 0%, rgba(7, 20, 32, 0.86) 42%, rgba(7, 20, 32, 0.28) 100%);
			}
			.hero-content {
				padding-top: 4.5rem;
				padding-bottom: 4.5rem;
			}
			.eyebrow {
				margin: 0 0 0.8rem;
				color: #087e91;
				font-size: 0.8rem;
				font-weight: 700;
				letter-spacing: 0.14em;
				text-transform: uppercase;
			}
			.hero .eyebrow {
				color: #66e0dc;
			}
			.hero h1 {
				max-width: 700px;
				margin: 0;
				color: #fff;
				font-size: clamp(2.4rem, 5vw, 4.4rem);
				letter-spacing: -0.045em;
				line-height: 1.06;
			}
			.hero-copy {
				max-width: 620px;
				margin: 1.3rem 0 0;
				color: #d7e5ef;
				font-size: clamp(1rem, 1.7vw, 1.18rem);
			}
			.hero-actions {
				display: flex;
				flex-wrap: wrap;
				gap: 0.8rem;
				margin-top: 1.8rem;
			}
			.button {
				display: inline-flex;
				min-height: 48px;
				align-items: center;
				justify-content: center;
				gap: 0.55rem;
				padding: 0.7rem 1.2rem;
				border: 1px solid transparent;
				border-radius: 5px;
				font-size: 0.92rem;
				font-weight: 700;
				text-decoration: none;
				transition: background 160ms ease, transform 160ms ease;
			}
			.button:hover {
				transform: translateY(-2px);
			}
			.button-primary {
				background: #0db5ba;
				color: #fff;
			}
			.button-primary:hover {
				background: #078e9b;
				color: #fff;
			}
			.button-secondary {
				border-color: rgba(255, 255, 255, 0.55);
				color: #fff;
			}
			.button-secondary:hover {
				background: rgba(255, 255, 255, 0.12);
				color: #fff;
			}
			.hero-tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.55rem;
				margin-top: 2rem;
			}
			.hero-tags span {
				padding: 0.35rem 0.65rem;
				border: 1px solid rgba(255, 255, 255, 0.2);
				border-radius: 4px;
				background: rgba(8, 24, 37, 0.4);
				color: #e2f0f2;
				font-size: 0.78rem;
			}
			.services-section {
				padding: clamp(3.5rem, 7vw, 5.5rem) 0;
				background: #f3f6f7;
			}
			.section-heading {
				display: flex;
				align-items: end;
				justify-content: space-between;
				gap: 2rem;
				margin-bottom: 1.8rem;
			}
			.section-heading h2 {
				margin: 0;
				color: #153653;
				font-size: clamp(1.8rem, 3.4vw, 2.65rem);
				letter-spacing: -0.03em;
			}
			.section-heading p {
				max-width: 510px;
				margin: 0;
				color: rgb(var(--gray));
				font-size: 1rem;
			}
			.services-grid {
				display: grid;
				grid-template-columns: repeat(3, minmax(0, 1fr));
				gap: 1.2rem;
			}
			.service-card {
				overflow: hidden;
				border: 1px solid #e1e8eb;
				border-radius: 10px;
				background: #fff;
				box-shadow: 0 8px 24px rgba(16, 36, 62, 0.045);
				transition: box-shadow 180ms ease, transform 180ms ease;
			}
			.service-card:hover {
				box-shadow: 0 16px 36px rgba(16, 36, 62, 0.12);
				transform: translateY(-3px);
			}
			.service-card img {
				display: block;
				width: 100%;
				aspect-ratio: 16 / 8.5;
				border-radius: 0;
				object-fit: cover;
			}
			.service-content {
				padding: 1.25rem 1.35rem 1.5rem;
			}
			.service-content h3 {
				margin: 0 0 0.5rem;
				color: #153653;
				font-size: 1.2rem;
			}
			.service-content p {
				margin: 0;
				color: rgb(var(--gray));
				font-size: 0.96rem;
				line-height: 1.65;
			}
			.experience-section {
				padding: clamp(3.5rem, 7vw, 5.5rem) 0;
				background: #fff;
			}
			.experience-grid {
				display: grid;
				grid-template-columns: 1.15fr 0.85fr;
				align-items: center;
				gap: clamp(2rem, 7vw, 6rem);
			}
			.experience-copy h2 {
				margin: 0 0 1rem;
				color: #153653;
				font-size: clamp(1.8rem, 3.4vw, 2.65rem);
				letter-spacing: -0.03em;
			}
			.experience-copy > p:not(.eyebrow) {
				margin: 0;
				color: rgb(var(--gray));
			}
			.credentials {
				display: grid;
				gap: 0.85rem;
			}
			.credential {
				padding: 1rem 1.1rem;
				border-left: 3px solid #0daeb5;
				background: #f3f7f8;
			}
			.credential strong {
				display: block;
				color: #153653;
				font-size: 0.98rem;
			}
			.credential span {
				display: block;
				margin-top: 0.2rem;
				color: rgb(var(--gray));
				font-size: 0.88rem;
			}
			.bottom-cta {
				padding: 2.5rem 0;
				background: #10243e;
				color: #fff;
			}
			.bottom-cta-inner {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 2rem;
			}
			.bottom-cta h2 {
				margin: 0;
				color: #fff;
				font-size: clamp(1.4rem, 2.5vw, 2rem);
			}
			.bottom-cta p {
				margin: 0.35rem 0 0;
				color: #c5d6e0;
				font-size: 0.96rem;
			}
			@media (max-width: 760px) {
				.hero {
					min-height: 0;
				}
				.hero-image {
					object-position: 64% center;
				}
				.hero-shade {
					background: linear-gradient(90deg, rgba(7, 20, 32, 0.95), rgba(7, 20, 32, 0.64));
				}
				.hero-content {
					padding-top: 4rem;
					padding-bottom: 4rem;
				}
				.section-heading,
				.bottom-cta-inner {
					align-items: flex-start;
					flex-direction: column;
				}
				.section-heading {
					gap: 0.75rem;
				}
				.services-grid,
				.experience-grid {
					grid-template-columns: 1fr;
				}
			}
			@media (prefers-reduced-motion: reduce) {
				* {
					scroll-behavior: auto !important;
					transition-duration: 0.01ms !important;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main class="home-main">
			<section class="hero">
				<img
					class="hero-image"
					src={automationHero.src}
					alt="Endüstriyel otomasyon tesisi ve elektrik kontrol panosu"
					width="1600"
					height="760"
					fetchpriority="high"
				/>
				<div class="hero-shade" aria-hidden="true"></div>
				<div class="container hero-content">
					<p class="eyebrow">Elektrik-Elektronik Mühendisi · Endüstriyel Otomasyon</p>
					<h1>Elektrik, elektronik ve otomasyon sahada hayat bulur.</h1>
					<p class="hero-copy">
						Ben Hasan Keskin. Endüstriyel tesislerde edindiğim bakım ve otomasyon
						deneyimini; PLC, kontrol sistemleri ve mühendislik uygulamaları üzerine
						teknik paylaşımlarla buluşturuyorum.
					</p>
					<div class="hero-actions">
						<a class="button button-primary" href="#uzmanliklar">
							Uzmanlık alanlarım <span aria-hidden="true">→</span>
						</a>
						<a class="button button-secondary" href="/about/">Mesleki yolculuğum</a>
					</div>
					<div class="hero-tags" aria-label="Öne çıkan teknik alanlar">
						<span>Siemens TIA Portal</span>
						<span>PLC &amp; HMI</span>
						<span>Elektrik bakım</span>
						<span>Motor sürücüleri</span>
					</div>
				</div>
			</section>

			<section class="services-section" id="uzmanliklar">
				<div class="container">
					<div class="section-heading">
						<div>
							<p class="eyebrow">Uzmanlık alanları</p>
							<h2>Üretimin arkasındaki sistemler</h2>
						</div>
						<p>
							Elektrik altyapısından PLC kontrolüne kadar, endüstriyel sistemlerin
							güvenli ve verimli çalışmasına katkı sağlayan konular.
						</p>
					</div>
					<div class="services-grid">
						<article class="service-card">
							<img src={plcIllustration.src} alt="" width="720" height="400" loading="lazy" />
							<div class="service-content">
								<h3>PLC ve endüstriyel otomasyon</h3>
								<p>
									Siemens TIA Portal, PLC programlama, HMI ekranları ve makine kontrol
									süreçleri üzerine saha odaklı teknik notlar.
								</p>
							</div>
						</article>
						<article class="service-card">
							<img src={maintenanceIllustration.src} alt="" width="720" height="400" loading="lazy" />
							<div class="service-content">
								<h3>Elektrik bakım ve arıza analizi</h3>
								<p>
									Endüstriyel tesislerde arıza tespiti, planlı bakım, pano uygulamaları
									ve sistem sürekliliği.
								</p>
							</div>
						</article>
						<article class="service-card">
							<img src={designIllustration.src} alt="" width="720" height="400" loading="lazy" />
							<div class="service-content">
								<h3>Elektrik ve mühendislik çözümleri</h3>
								<p>
									Elektrik projelendirme, motor sürücüleri, elektronik tasarım ve
									üretim teknolojileri üzerine deneyimler.
								</p>
							</div>
						</article>
					</div>
				</div>
			</section>

			<section class="experience-section">
				<div class="container experience-grid">
					<div class="experience-copy">
						<p class="eyebrow">Saha deneyimi ve eğitim</p>
						<h2>Mühendislik, öğrenmeye ve paylaşmaya devam etmek.</h2>
						<p>
							2021 yılından bu yana elektrik bakım ve onarım süreçlerinde görev alıyorum.
							Akademik altyapımı saha tecrübemle birleştirerek teknik konuları anlaşılır,
							uygulanabilir bilgiler halinde paylaşmayı amaçlıyorum.
						</p>
					</div>
					<div class="credentials">
						<div class="credential">
							<strong>Elektrik-Elektronik Mühendisliği</strong>
							<span>Aksaray Üniversitesi · 2020</span>
						</div>
						<div class="credential">
							<strong>Elektrik İletim ve Dağıtım</strong>
							<span>Selçuk Üniversitesi · 2016</span>
						</div>
						<div class="credential">
							<strong>Elektrik ve Otomasyon</strong>
							<span>Mesleki ve teknik lise · 2014</span>
						</div>
					</div>
				</div>
			</section>

			<section class="bottom-cta">
				<div class="container bottom-cta-inner">
					<div>
						<h2>Otomasyon ve mühendislik üzerine daha fazlası</h2>
						<p>Teknik yazıları inceleyin veya mesleki yolculuğum hakkında bilgi alın.</p>
					</div>
					<div class="hero-actions">
						<a class="button button-primary" href="/blog/">Teknik yazılar</a>
						<a class="button button-secondary" href="/about/">Hakkımda</a>
					</div>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
