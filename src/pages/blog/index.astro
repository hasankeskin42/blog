---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="tr">
	<head>
		<BaseHead title={`Blog | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main {
				padding-top: 3.5rem;
			}
			.page-heading {
				max-width: 720px;
				margin-bottom: 2rem;
			}
			.page-heading .eyebrow {
				margin: 0 0 0.6rem;
				color: var(--accent-dark);
				font-size: 0.85rem;
				font-weight: 700;
				letter-spacing: 0.12em;
				text-transform: uppercase;
			}
			.page-heading h1 {
				margin: 0 0 0.75rem;
				color: #153653;
				letter-spacing: -0.035em;
			}
			.page-heading p {
				margin: 0;
				color: rgb(var(--gray));
			}
			.post-list {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 1.25rem;
				margin: 0;
				padding: 0;
				list-style: none;
			}
			.post-card {
				display: flex;
				overflow: hidden;
				min-width: 0;
				flex-direction: column;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 18px;
				background: #fff;
				transition: box-shadow 180ms ease, transform 180ms ease;
			}
			.post-card:hover {
				box-shadow: var(--box-shadow);
				transform: translateY(-3px);
			}
			.post-card a {
				display: flex;
				height: 100%;
				flex-direction: column;
				color: inherit;
				text-decoration: none;
			}
			.post-card img {
				display: block;
				width: 100%;
				aspect-ratio: 16 / 8;
				object-fit: cover;
				border-radius: 0;
			}
			.post-content {
				display: flex;
				flex: 1;
				flex-direction: column;
				align-items: flex-start;
				padding: 1.35rem;
			}
			.post-content time {
				color: rgb(var(--gray));
				font-size: 0.85rem;
			}
			.post-content h2 {
				margin: 0.55rem 0;
				color: #153653;
				font-size: 1.35rem;
				line-height: 1.35;
			}
			.post-content p {
				margin: 0;
				color: rgb(var(--gray));
				font-size: 0.95rem;
			}
			.read-more {
				margin-top: auto;
				padding-top: 1.1rem;
				color: var(--accent-dark);
				font-size: 0.92rem;
				font-weight: 700;
			}
			@media (max-width: 680px) {
				.post-list {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<header class="page-heading">
				<p class="eyebrow">Teknik notlar ve deneyimler</p>
				<h1>Blog</h1>
				<p>Elektrik, elektronik ve endüstriyel otomasyon üzerine yazılar.</p>
			</header>
			<ul class="post-list">
				{posts.map((post) => (
					<li class="post-card">
						<a href={`/blog/${post.id}/`}>
							{post.data.heroImage && (
								<Image width={720} height={360} src={post.data.heroImage} alt="" />
							)}
							<div class="post-content">
								<FormattedDate date={post.data.pubDate} />
								<h2>{post.data.title}</h2>
								<p>{post.data.description}</p>
								<span class="read-more">Yazıyı oku <span aria-hidden="true">→</span></span>
							</div>
						</a>
					</li>
				))}
			</ul>
		</main>
		<Footer />
	</body>
</html>
