---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import technologyBackdrop from '../assets/industrial-automation-hero.svg';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate } = Astro.props;
---

<html lang="tr">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: 100%;
				max-width: none;
				margin: 0;
				padding: 0;
			}
			.article-hero {
				position: relative;
				display: flex;
				min-height: 320px;
				align-items: center;
				overflow: hidden;
				background: #10243e;
				isolation: isolate;
			}
			.article-hero > img,
			.article-hero::before {
				position: absolute;
				z-index: -1;
				inset: 0;
				width: 100%;
				height: 100%;
			}
			.article-hero > img {
				object-fit: cover;
				object-position: center;
			}
			.article-hero::before {
				background: linear-gradient(90deg, rgba(7, 20, 32, .94), rgba(7, 20, 32, .52));
				content: '';
			}
			.title {
				width: 100%;
				max-width: var(--page-width);
				margin: 0 auto;
				padding: 3.5rem 1.25rem;
				text-align: left;
			}
			.title h1 {
				margin: 0 0 .75rem;
				color: #fff;
				font-size: clamp(2rem, 4.5vw, 3.5rem);
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: 2rem auto 4rem;
				padding: 1rem;
				color: rgb(var(--gray-dark));
			}
			.date {
				margin-bottom: 0.5em;
				color: #c7dce5;
				font-size: 0.92rem;
			}
			.last-updated-on {
				font-style: italic;
			}
			.prose :global(h2) {
				margin-top: 2rem;
				font-size: clamp(1.6rem, 3vw, 2rem);
			}
			.prose :global(h3) {
				margin-top: 1.5rem;
				font-size: 1.35rem;
			}
			.prose :global(pre) {
				overflow-x: auto;
				background: #10243e;
				color: #f4f7fb;
			}
			@media (max-width: 720px) {
				.article-hero {
					min-height: 260px;
				}
				.title {
					padding: 2.5rem 1rem;
				}
				.prose {
					max-width: 100%;
					padding: 0.75rem;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<header class="article-hero">
					<img src={technologyBackdrop.src} alt="" width="1600" height="760" />
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{updatedDate && (
								<div class="last-updated-on">
									Son güncelleme: <FormattedDate date={updatedDate} />
								</div>
							)}
						</div>
						<h1>{title}</h1>
					</div>
				</header>
				<div class="prose"><slot /></div>
			</article>
		</main>
		<Footer />
	</body>
</html>
