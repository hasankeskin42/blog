---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import brandLogo from '../assets/logo.webp';
---

<header>
	<div class="top-strip">
		<div class="top-inner">
			<span>Elektrik · Elektronik · Endüstriyel Otomasyon</span>
			<span class="top-note">Saha deneyiminden teknik paylaşımlar</span>
		</div>
	</div>
	<nav>
		<h2>
			<a href="/" class="brand-link" aria-label={SITE_TITLE}>
				<img
					class="brand-logo"
					src={brandLogo.src}
					alt="HASTUĞ Engineering - Electrical, Electronics, Automation"
					width="1024"
					height="707"
				/>
			</a>
		</h2>
		<div class="internal-links">
			<HeaderLink href="/">Ana Sayfa</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/about">Hakkımda</HeaderLink>
		</div>
		<a
			class="header-cta"
			href="https://www.linkedin.com/in/hasan-keskin-53504515a/"
			target="_blank"
			rel="noopener noreferrer"
		>
			Bağlantı kur <span aria-hidden="true">↗</span>
		</a>
		<div class="social-links">
			<a href="https://www.facebook.com/hasankeskin42" target="_blank" rel="noopener">
				<span class="sr-only">Facebook</span>
