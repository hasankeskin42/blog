				</svg>
			</a>
			<a href="https://www.youtube.com/@hasankeskin8083" target="_blank" rel="noopener">
				<span class="sr-only">YouTube</span>
				<svg viewBox="0 0 24 24" aria-hidden="true" width="32" height="32">
					<path fill="currentColor" d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2C0 8.1 0 12 0 12s0 3.9.5 5.8a3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1c.5-1.9.5-5.8.5-5.8s0-3.9-.5-5.8zM9.6 15.6V8.4l6.2 3.6-6.2 3.6z"/>
				</svg>
			</a>
                      <a href="https://twitter.com/Hasanksknn" target="_blank" rel="noopener">
	                        <span class="sr-only">Twitter</span>
	                        <svg viewBox="0 0 24 24" aria-hidden="true" width="32" height="32">
		                   <path fill="currentColor" d="M18.9 1.15h3.68l-8.04 9.19L24 22.85h-7.4l-5.8-7.58-6.64 7.58H.47l8.6-9.83L0 1.15h7.6l5.24 6.93 6.06-6.93zm-1.29 19.5h2.04L6.48 3.24H4.3l13.31 17.41z"/>
	</svg>
</a>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		background: #fff;
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	.top-strip {
		background: #0daeb5;
		color: #fff;
		font-size: 0.76rem;
		font-weight: 700;
	}
	.top-inner {
		display: flex;
		width: min(var(--page-width), calc(100% - 2.5rem));
		min-height: 31px;
		align-items: center;
		justify-content: space-between;
		margin: 0 auto;
		gap: 1rem;
	}
	.top-note {
		font-weight: 400;
	}
	h2 {
		margin: 0;
		font-size: 1rem;
		letter-spacing: 0.07em;
		white-space: nowrap;
	}
	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	.brand-link {
		display: block;
		padding: 0;
		border: 0;
	}
	.brand-logo {
		display: block;
		width: 340px;
		height: auto;
	}
	nav {
		width: min(var(--page-width), calc(100% - 2.5rem));
		min-height: 76px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin: 0 auto;
	}
	.internal-links {
		display: flex;
		align-items: center;
		gap: 0.35rem;
	}
	.internal-links a {
		padding: 0.6rem 0.85rem;
		color: rgb(var(--gray-dark));
		border-radius: 999px;
		text-decoration: none;
		font-size: 0.92rem;
		transition: background 160ms ease, color 160ms ease;
	}
	.internal-links a:hover,
	.internal-links a.active {
		background: #e8f4f7;
		color: var(--accent-dark);
	}
	.header-cta {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.7rem 1rem;
		border-radius: 6px;
		background: #0daeb5;
		color: #fff;
		font-size: 0.88rem;
		font-weight: 700;
		text-decoration: none;
		white-space: nowrap;
		transition: background 160ms ease;
	}
	.header-cta:hover {
		background: #087e91;
		color: #fff;
	}
	.social-links,
	.social-links a {
		display: flex;
	}
	.social-links {
		gap: 0.5rem;
	}
	.social-links a {
		align-items: center;
		justify-content: center;
		padding: 0.45rem;
		color: rgb(var(--gray));
		border-radius: 50%;
		transition: background 160ms ease, color 160ms ease;
	}
	.social-links a:hover {
		background: #e8f4f7;
		color: var(--accent-dark);
	}
	.social-links svg {
		width: 20px;
		height: 20px;
	}
	@media (max-width: 900px) {
		.social-links {
			display: none;
		}
	}
	@media (max-width: 720px) {
		.top-inner,
		nav {
			width: calc(100% - 2rem);
		}
		nav {
			min-height: 0;
			flex-wrap: wrap;
			justify-content: space-between;
			gap: 0.25rem 0.75rem;
			padding: 0.8rem 0 0;
		}
		.top-inner {
			min-height: 30px;
			font-size: 0.68rem;
		}
		.top-note {
			display: none;
		}
		h2 {
			font-size: 0.9rem;
		}
		.brand-logo {
			width: 300px;
		}
		.header-cta {
			padding: 0.55rem 0.75rem;
			font-size: 0.82rem;
		}
		.internal-links {
			order: 1;
			width: 100%;
			justify-content: center;
			gap: 0.1rem;
			margin-top: 0.35rem;
			border-top: 1px solid rgb(var(--gray-light));
		}
		.internal-links a {
			padding: 0.45rem 0.75rem;
			font-size: 0.88rem;
		}
	}
</style>